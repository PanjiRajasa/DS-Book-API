{
  "compilerOptions": {
    "target": "ES2020",                                  
    "module": "commonjs",    
    "moduleResolution": "node",                           
    "esModuleInterop": true,   
    "resolveJsonModule": true, 
    "outDir": "./dist",
    "rootDir": "./src",                         
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                     
    "skipLibCheck": true
  }
}
